<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mappa Dinamica</title>
    <style>
        body {
            transform: scale(0.8);
            transform-origin: top left;
        }

        #canva {
            width: 80%;
            height: auto;
        }

        #graphContainer {
            margin-top: 20px;
        }

        #errorMessage {
            color: red;
            font-weight: bold;
            margin-top: 20px;
            display: none;
        }

        .floor-selector {
            margin: 10px 0;
            padding: 5px;
        }
    </style>
</head>
<body>

    <h1>Viaggia</h1>

    <!-- Aggiunto selettore di piano -->
    <div class="floor-selector">
        <label for="floor">Piano:</label>
        <select id="floor" onchange="loadFloorData()"></select>
    </div>

    <!-- Textbox e bottone per inserire l'ID della mappa -->
    <label for="id">ID della Mappa:</label>
    <input type="text" id="id" name="id" required>
    <button onclick="loadMap()">Carica Mappa</button>

    <br><br>

    <label for="partenza">Seleziona la Partenza:</label>
    <select id="partenza"></select>

    <label for="arrivo">Seleziona la Fine:</label>
    <select id="arrivo"></select>

    <br><br>

    <button onclick="tracePath()">Traccia Percorso</button>

    <br><br>

    <canvas id="canva" style="border: 1px solid black;"></canvas>
    <div id="errorMessage">Errore: Immagine non trovata per l'ID specificato.</div>

    <script>
        const canvas = document.getElementById('canva');
        const ctx = canvas.getContext('2d');
        let currentMapData = {
            points: [],
            arcs: [],
            floors: [],
            currentFloor: null
        };

        // Modificata per caricare i piani
        async function loadMap() {
            const id = document.getElementById('id').value;
            try {
                const [floorsRes, pointsRes, arcsRes] = await Promise.all([
                    fetch(`/floorsJson/?id=${id}`),
                    fetch(`/pointsJson/?id=${id}`),
                    fetch(`/arcsJson/?id=${id}`)
                ]);

                currentMapData.floors = await floorsRes.json();
                currentMapData.points = await pointsRes.json();
                currentMapData.arcs = await arcsRes.json();

                populateFloorSelector();
                loadFloorData();
            } catch (error) {
                console.error('Errore nel caricamento:', error);
                document.getElementById('errorMessage').style.display = 'block';
            }
        }

        function populateFloorSelector() {
            const floorSelect = document.getElementById('floor');
            floorSelect.innerHTML = '';
            currentMapData.floors.forEach(floor => {
                floorSelect.add(new Option(floor.name, floor.floor));
            });
            currentMapData.currentFloor = currentMapData.floors[0]?.floor;
        }

        // Nuova funzione per caricare i dati del piano selezionato
        async function loadFloorData() {
            const floor = document.getElementById('floor').value;
            currentMapData.currentFloor = floor;
            
            const imageUrl = `/map_image/?id=${document.getElementById('id').value}&floor=${floor}`;
            await drawMapImage(imageUrl);
            
            const filteredPoints = currentMapData.points.filter(p => p.floor == floor);
            const filteredArcs = currentMapData.arcs.filter(a => 
                a.floorA == floor && a.floorB == floor
            );

            updateDropdowns(filteredPoints);
            drawPoints(filteredPoints);
            drawArcs(filteredArcs, filteredPoints);
        }

        async function drawMapImage(imageUrl) {
            return new Promise((resolve, reject) => {
                const img = new Image();
                img.onload = () => {
                    canvas.width = img.width;
                    canvas.height = img.height;
                    ctx.drawImage(img, 0, 0);
                    resolve();
                };
                img.onerror = reject;
                img.src = imageUrl;
            });
        }

        function updateDropdowns(points) {
            const partenzaSelect = document.getElementById('partenza');
            const arrivoSelect = document.getElementById('arrivo');
            
            partenzaSelect.innerHTML = '';
            arrivoSelect.innerHTML = '';

            points.forEach(point => {
                partenzaSelect.add(new Option(point.name, point.name));
                arrivoSelect.add(new Option(point.name, point.name));
            });
        }

        function drawPoints(points) {
            points.forEach(point => {
                const [x, y] = point.cordinatepunti.split(',').map(coord => parseInt(coord.trim()));
                ctx.beginPath();
                ctx.fillStyle = 'red';
                ctx.arc(x, y, 10, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillText(point.name, x + 12, y - 12);
            });
        }

        function drawArcs(arcs, points) {
            arcs.forEach(arc => {
                const start = points.find(p => p.label === arc.labelA);
                const end = points.find(p => p.label === arc.labelB);
                if (start && end) {
                    const [x1, y1] = start.cordinatepunti.split(',').map(coord => parseInt(coord.trim()));
                    const [x2, y2] = end.cordinatepunti.split(',').map(coord => parseInt(coord.trim()));
                    ctx.beginPath();
                    ctx.moveTo(x1, y1);
                    ctx.lineTo(x2, y2);
                    ctx.strokeStyle = 'blue';
                    ctx.lineWidth = 3;
                    ctx.stroke();
                }
            });
        }

        // Resto del codice rimane simile...
    </script>

</body>
</html>